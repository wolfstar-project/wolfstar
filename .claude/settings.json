{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(**/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.*.local)",
			"Read(**/.env.production)",
			"Read(**/.env.staging)",
			"Edit(**/.env.local)",
			"Edit(**/.env.*.local)",
			"Bash(cat **/.env.local)",
			"Bash(cat **/.env.*.local)",
			"Bash(printenv:*)",
			"Bash(env)"
		]
	}
}
