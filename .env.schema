# Shared WolfStar configuration, imported by every workspace package.
#
# Each package owns a schema next to its code and imports what it needs from here:
#   projects/bot/src/.env.schema   projects/database/.env.schema
# Only what more than one package (or the repository tooling) reads lives in this file.
#
# This file is safe to commit, it only holds declarations. Real secrets never go here or in a tracked .env file:
# they come from `.env.local` / `.env.<env>.local` (git-ignored), or from the process environment, which always wins
# (that is how the deployed containers get theirs).
#
# See https://varlock.dev/env-spec for the syntax and `pnpm exec varlock load --agent` to validate it.
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# ----------

# Selects which `.env.<NODE_ENV>` files are loaded (see https://varlock.dev/guides/environments/)
# @required @type=enum(development, production, test)
NODE_ENV=development

# PostgreSQL connection string, read by the bot and by the Prisma tooling (`projects/database`).
# The throw-away docker-compose value lives in the tracked `.env.development`, so the item is only sensitive in
# production: otherwise `varlock scan` would (rightly) flag that committed local URL. If you point your development
# environment at a real database, keep its URL in `.env.development.local`, where nothing scans it.
# @required @sensitive=forEnv(production) @type=string(startsWith=postgres)
# @example="postgresql://user:password@localhost:5432/wolfstar?schema=public"
DATABASE_URL=

# API key of the Tolgee project the locale files are pushed to and pulled from (`pnpm tolgee:push` / `tolgee:pull`).
# Only the localization tooling needs it, never commit it.
# @optional @sensitive
# @docs(https://docs.tolgee.io/tolgee-cli/authentication)
TOLGEE_API_KEY=
