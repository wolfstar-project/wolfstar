# Ignore a blackhole and the folder for development
node_modules/
.vs/
.idea/
*.iml
/rethinkdb_data/
coverage/

# Yarn files
.yarn/install-state.gz
.yarn/build-state.yml

# Environment variables
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
redis.local.conf

# Ignore bwd folders
dist/

# Ignore auto-generated files
.config/
generated/

# Tolgee pull staging (promoted into src/languages by scripts/tolgee-pull-remap.ts)
.tolgee-pull/
# Sync summary emitted by the same script (used as the PR body by the sync workflow)
.tolgee-report.md

# Ignore heapsnapshot and log files
*.heapsnapshot
*.log

# Ignore package locks
package-lock.json

# Ignore the GH cli downloaded by workflows
gh

# Ignore the "wiki" folder so we can checkout the wiki inside the same folder
wiki/

# Profiler data
*.0x

# Claude
.claude/state

# Plans
plans/

# `prisma skills sync` writes a 1.5 MB copy of the Prisma 8 reference docs into
# each supported agent directory. Regenerate on demand instead of committing it.
projects/*/.agents/
projects/*/.claude/
projects/*/.cursor/
projects/*/.devin/
