{
	"name": "wolfstar",
	"version": "7.0.0",
	"description": "Multipurpose Discord bot built on the WolfStar HTTP Framework",
	"author": "WolfStar Project",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r run build",
		"dev": "pnpm --filter wolfstar-bot dev",
		"watch": "pnpm --filter wolfstar-bot watch",
		"stars": "pnpm --filter wolfstar-bot exec stars",
		"prisma:generate": "pnpm --filter wolfstar-database prisma:generate",
		"clean": "pnpm -r run clean",
		"test": "vitest run --config vitest.config.ts",
		"lint:fix": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"typecheck": "golar typecheck",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"scripts:tlds": "node --experimental-strip-types scripts/tlds.ts",
		"scripts:phishing": "node --experimental-strip-types scripts/phishing.ts",
		"prepare": "node .husky/install.mjs",
		"tolgee:pull": "varlock run -- tolgee pull && node --experimental-strip-types scripts/tolgee-pull-remap.ts",
		"tolgee:push": "varlock run -- tolgee push --languages en-US",
		"tolgee:remap": "node --experimental-strip-types scripts/tolgee-pull-remap.ts"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@sapphire/fetch": "^3.0.5",
		"@sapphire/ts-config": "^5.0.3",
		"@tolgee/cli": "^2.21.0",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.1.0",
		"cz-conventional-changelog": "^3.3.0",
		"golar": "^0.1.11",
		"husky": "^9.1.7",
		"knip": "^6.44.2",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"taze": "^21.3.0",
		"tsdown": "0.23.7",
		"typescript": "^7.0.2",
		"varlock": "^1.24.0",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/wolfstar.git"
	},
	"engines": {
		"node": ">=24",
		"pnpm": ">=12"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"nano-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern",
		"*.{mjs,js,ts}": "oxlint --fix"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"packageManager": "pnpm@12.18.0"
}
