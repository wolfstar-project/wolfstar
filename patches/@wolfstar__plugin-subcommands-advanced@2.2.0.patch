+/**
+* The entries of a registry in the order of their names. A registry is filled in the order the stores load the pieces,
+* which is not the same from a start to the next, and Discord compares the options of a command by their position.
+*/
+function sortedEntries(entries) {
+	const nameOf = (entry) => {
+		const command = entry.slashCommand;
+		return (typeof command?.toJSON === "function" ? command.toJSON().name : command?.name) ?? "";
+	};
+	return [...entries.values()].sort((a, b) => nameOf(a).localeCompare(nameOf(b), "en"));
+}
