{
	"name": "wolfstar-bot",
	"version": "7.0.0",
	"description": "Multipurpose Discord bot built on the WolfStar HTTP Framework",
	"author": "WolfStar Project",
	"license": "Apache-2.0",
	"private": true,
	"main": "dist/main.mjs",
	"type": "module",
	"imports": {
		"#types": "./dist/lib/types/index.mjs",
		"#types/*": "./dist/lib/types/*.mjs",
		"#lib/*": "./dist/lib/*.mjs",
		"#common": "./dist/lib/common/index.mjs",
		"#common/*": "./dist/lib/common/*.mjs",
		"#utils/*": "./dist/lib/utilities/*.mjs",
		"#root/*": "./dist/*.mjs"
	},
	"scripts": {
		"build": "stars build",
		"i18n:generate": "stars codegen",
		"dev": "stars dev",
		"watch": "stars dev",
		"clean": "node scripts/clean.mjs",
		"start": "node --enable-source-maps dist/main.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"stars:info": "stars info"
	},
	"dependencies": {
		"@discordjs/builders": "^1.14.1",
		"@discordjs/collection": "^2.1.1",
		"@sapphire/async-queue": "^1.5.5",
		"@sapphire/result": "^2.8.0",
		"@sapphire/utilities": "^3.18.2",
		"@sentry/node": "^10.75.3",
		"@skyra/char": "^1.0.3",
		"@skyra/jaro-winkler": "^1.1.1",
		"@wolfstar/env-utilities": "^2.1.1",
		"@wolfstar/http-framework": "^5.1.0",
		"@wolfstar/plugin-api": "^1.1.6",
		"@wolfstar/plugin-i18next": "^2.0.4",
		"@wolfstar/plugin-logger": "^0.2.0",
		"@wolfstar/plugin-subcommands-advanced": "^2.0.4",
		"@wolfstar/shared-http-pieces": "^2.0.6",
		"@wolfstar/start-banner": "^2.1.1",
		"colorette": "^2.0.20",
		"discord-api-types": "^0.38.55",
		"gradient-string": "^3.0.0",
		"tslib": "^2.8.1",
		"wolfstar-database": "workspace:^",
		"wolfstar-shared": "workspace:^"
	},
	"devDependencies": {
		"@rollup/plugin-alias": "6.0.0",
		"@sapphire/framework": "^5.5.1",
		"@wolfstar/cli": "^2.0.1",
		"@wolfstar/i18next-type-generator": "^3.1.4",
		"discord.js": "^14.27.0",
		"tsdown": "0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
