{
	"name": "wolfstar-bot",
	"version": "7.0.0",
	"description": "Multipurpose Discord bot built on the WolfStar HTTP Framework",
	"author": "WolfStar Project",
	"license": "Apache-2.0",
	"private": true,
	"main": "dist/main.mjs",
	"type": "module",
	"imports": {
		"#types": "./dist/lib/types/index.mjs",
		"#types/*": "./dist/lib/types/*.mjs",
		"#lib/*": "./dist/lib/*.mjs",
		"#common": "./dist/lib/common/index.mjs",
		"#common/*": "./dist/lib/common/*.mjs",
		"#utils/*": "./dist/lib/utilities/*.mjs",
		"#root/*": "./dist/*.mjs"
	},
	"scripts": {
		"build": "stars build",
		"i18n:generate": "stars codegen",
		"typecheck": "stars typecheck",
		"dev": "stars dev",
		"clean": "node scripts/clean.mjs",
		"start": "node --enable-source-maps --import ./instrumentation.mjs dist/main.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"stars:info": "stars info"
	},
	"dependencies": {
		"@aero/sanitizer": "^1.3.2",
		"@discordjs/builders": "^1.14.1",
		"@discordjs/collection": "^2.1.1",
		"@discordjs/formatters": "^0.6.2",
		"@discordjs/rest": "^2.6.3",
		"@influxdata/influxdb-client": "^1.35.0",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/auto-instrumentations-node": "^0.82.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
		"@opentelemetry/instrumentation": "^0.300.0",
		"@opentelemetry/sdk-node": "^0.300.0",
		"@opentelemetry/sdk-trace": "^3.0.0",
		"@sapphire/async-queue": "^1.5.5",
		"@sapphire/bitfield": "^1.2.4",
		"@sapphire/pieces": "^4.4.1",
		"@sapphire/ratelimits": "^2.4.11",
		"@sapphire/result": "^2.8.0",
		"@sapphire/snowflake": "^3.5.5",
		"@sapphire/time-utilities": "^1.7.14",
		"@sapphire/utilities": "^3.18.3",
		"@skyra/char": "^1.0.3",
		"@wolfstar/decorators": "^0.1.3",
		"@wolfstar/env-utilities": "^2.3.1",
		"@wolfstar/http-framework": "^6.5.1",
		"@wolfstar/http-framework-utilities": "^0.1.2",
		"@wolfstar/kit": "^0.3.1",
		"@wolfstar/plugin-api": "^2.2.0",
		"@wolfstar/plugin-broker": "^0.7.0",
		"@wolfstar/plugin-cache": "^0.8.0",
		"@wolfstar/plugin-gateway": "^0.16.0",
		"@wolfstar/plugin-i18next": "^2.3.0",
		"@wolfstar/plugin-logger": "^0.5.0",
		"@wolfstar/plugin-scheduled-tasks": "^0.3.0",
		"@wolfstar/plugin-sharder": "^0.3.0",
		"@wolfstar/plugin-subcommands-advanced": "^2.3.0",
		"@wolfstar/shared-http-pieces": "^2.1.0",
		"@wolfstar/shared-influx-pieces": "^1.2.0",
		"@wolfstar/start-banner": "^2.1.3",
		"colorette": "^2.0.20",
		"confusables": "^1.1.1",
		"diff": "^9.0.0",
		"discord-api-types": "^0.38.56",
		"evlog": "^2.33.0",
		"gradient-string": "^3.0.0",
		"i18next": "^26.4.7",
		"ioredis": "^6.0.0",
		"varlock": "^1.23.0",
		"wolfstar-database": "workspace:^",
		"wolfstar-shared": "workspace:^"
	},
	"devDependencies": {
		"@rollup/plugin-alias": "6.0.0",
		"@wolfstar/i18next-type-generator": "^3.1.6",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"varlock": {
		"loadPath": "./src/"
	}
}
