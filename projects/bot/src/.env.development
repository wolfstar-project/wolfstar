# Local development defaults for the bot: the Redis and InfluxDB containers of `compose.dev.yaml`.
# Only throw-away local values belong here. Your Discord token and anything else private goes in
# `.env.development.local` (git-ignored).
CLIENT_VERSION="7.0.0-dev [Testa Edition]"

API_ORIGIN="http://localhost:3000"
API_PREFIX="/"

REDIS_HOST=localhost
REDIS_PORT=8287
REDIS_DB=1
REDIS_PASSWORD=redis

INFLUX_URL="http://localhost:8285"

WORKER_COUNT=2
