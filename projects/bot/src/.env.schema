# Environment of the WolfStar bot (`projects/bot`), loaded by `varlock/auto-load` from `src/main.ts`.
# `package.json#varlock.loadPath` points here, so it is this directory's schema and `.env.<NODE_ENV>` files that apply.
#
# The shared items (NODE_ENV, DATABASE_URL, the Proton Pass plugin) are declared once in the repository root schema and
# imported below. Everything specific to the bot is declared in this file.
#
# Values, from lowest to highest precedence: the defaults below, `.env.<NODE_ENV>` (tracked, local-only defaults),
# `.env.local` and `.env.<NODE_ENV>.local` (git-ignored, your own values and secrets), then the process environment.
# Secrets are never written in a tracked file: resolve them from Proton Pass (`USE_PROTON_PASS=true`) or set them in
# a git-ignored `.local` file. `pnpm exec varlock load --agent` validates the result with sensitive values redacted.
#
# @import(../../../, pick=[NODE_ENV, USE_PROTON_PASS, PROTON_PASS_PERSONAL_ACCESS_TOKEN, DATABASE_URL])
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./@types/env.d.ts)
# ----------

# ---------- Application ----------

# Name and version shown in the startup banner
CLIENT_NAME=WolfStar
CLIENT_VERSION="7.0.0 [Testa Edition]"

# Discord IDs of the bot's owners, separated by spaces
# @optional
CLIENT_OWNERS="605162125027049472 604339998312890379"

# ID of the Discord application, which is also the bot user's ID. Public, it is written in every invite link.
# @required @docs(https://discord.com/developers/applications)
CLIENT_ID=854714837388755004

# ---------- Discord ----------

# Token of the bot user. Only the running bot needs it, the unit tests run without.
# @required=forEnv(development, production) @sensitive
# @docs(https://discord.com/developers/docs/topics/oauth2#bot-users)
DISCORD_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/discord-bot/token, allowMissing=true), "")

# Public key Discord signs the interaction requests with. Public, but specific to the application.
# @required=forEnv(development, production)
DISCORD_PUBLIC_KEY=

# ---------- HTTP interactions endpoint ----------

# Address and port the interactions endpoint listens on
# @type=string
HTTP_ADDRESS=127.0.0.1
# @type=port
HTTP_PORT=3000

# ---------- REST API (@wolfstar/plugin-api) ----------

# @type=boolean
API_ENABLED=true
# @type=string
API_HOST=127.0.0.1
# @type=port
API_PORT=8282
# Origin allowed by CORS, `*` for any
API_ORIGIN="*"
# Path every API route is served under, empty for none
API_PREFIX=

# ---------- Redis (entity cache and gateway session store) ----------
# The unit tests never connect to Redis, so nothing below is required in the `test` environment.

# @required=forEnv(development, production) @type=string
REDIS_HOST=localhost
# @required=forEnv(development, production) @type=port
REDIS_PORT=6379
# @required=forEnv(development, production) @type=number(min=0)
REDIS_DB=0
# Only sensitive in production: the development value is the throw-away password of the local docker-compose Redis.
# @required=forEnv(development, production) @sensitive=forEnv(production)
REDIS_PASSWORD=if($USE_PROTON_PASS, protonPass(pass://WolfStar/redis/password, allowMissing=true), "")

# ---------- Gateway dispatch broker (@wolfstar/plugin-broker) ----------
# Publishes every gateway dispatch onto a Redis stream (same Redis as above) for workers to replay. Off unless a
# worker consumes the stream, otherwise the stream only fills up to BROKER_MAX_LENGTH entries.

# @type=boolean
BROKER_ENABLED=false
# Redis key of the stream
# @type=string
BROKER_STREAM=wolfstar:events
# The stream is trimmed to approximately this many entries on every publish
# @type=number(min=1)
BROKER_MAX_LENGTH=100000

# ---------- Moderation workers ----------

# Number of threads that run the message filters. Defaults to the number of CPUs when unset.
# @optional @type=number(min=1)
WORKER_COUNT=

# ---------- Error reporting ----------

# @optional @sensitive @docs(https://docs.sentry.io/concepts/key-terms/dsn-explainer/)
SENTRY_DSN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/sentry/dsn, allowMissing=true), "")

# Discord webhook the error listeners report to
# @optional
WEBHOOK_ERROR_ID=648663047615021058
# @optional @sensitive
WEBHOOK_ERROR_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/discord-error-webhook/token, allowMissing=true), "")

# ---------- Analytics (InfluxDB) ----------

# @type=boolean
INFLUX_ENABLED=false
# @optional @type=url
INFLUX_URL=
# @optional
INFLUX_ORG=WolfStar-Project
# @optional
INFLUX_ORG_ANALYTICS_BUCKET=analytics
# @optional @sensitive
INFLUX_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/influxdb/token, allowMissing=true), "")

# ---------- Bot lists (server count statistics, all optional) ----------

# @optional @sensitive
TOP_GG_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/bot-lists/top_gg, allowMissing=true), "")
# @optional @sensitive
DISCORD_BOTS_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/bot-lists/discord_bots_gg, allowMissing=true), "")
# @optional @sensitive
DISCORD_BOT_LIST_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/bot-lists/discordbotlist, allowMissing=true), "")
# @optional @sensitive
BOTS_FOR_DISCORD_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/bot-lists/discords, allowMissing=true), "")
# @optional @sensitive
BOTS_ON_DISCORD_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/bot-lists/bots_on_discord, allowMissing=true), "")
# @optional @sensitive
BOTLIST_SPACE_TOKEN=if($USE_PROTON_PASS, protonPass(pass://WolfStar/bot-lists/discordlist_space, allowMissing=true), "")
