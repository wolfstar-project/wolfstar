{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"experimentalDecorators": true,
		"outDir": "../dist",
		"rootDir": ".",
		"paths": {
			"#utils/*": ["./lib/util/*"],
			"#lib/*": ["./lib/*"],
			"#languages": ["./locales/index"],
			"#root/*": ["./*"]
		},
		"composite": true
	},
	"include": [".", "./**/*.json", "../.stars/imports.d.ts"],
	"exclude": ["./tsconfig.json"]
}
