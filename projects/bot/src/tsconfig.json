{
	"extends": "../.stars/tsconfig.json",
	"compilerOptions": {
		"rootDir": "..",
		"paths": {
			"#lib/*": ["./lib/*"],
			"#common": ["./lib/common/index"],
			"#common/*": ["./lib/common/*"],
			"#types": ["./lib/types/index"],
			"#types/*": ["./lib/types/*"],
