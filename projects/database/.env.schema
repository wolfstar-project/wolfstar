# Environment of the database package (Prisma contract tooling and the runtime client).
# It only needs the connection string, which the repository root owns so the bot and this package always agree on
# the name. The extra keys are what that item depends on (the current environment and the secrets store opt-in).
#
# @import(../../, pick=[NODE_ENV, USE_PROTON_PASS, PROTON_PASS_PERSONAL_ACCESS_TOKEN, DATABASE_URL])
# @defaultRequired=infer @defaultSensitive=false
# ----------
