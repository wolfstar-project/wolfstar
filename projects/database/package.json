{
	"name": "wolfstar-database",
	"version": "7.0.0",
	"description": "Database utilities for Wolfstar's projects",
	"author": "WolfStar Project",
	"license": "Apache-2.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		"import": "./dist/index.js",
		"types": "./dist/index.d.ts"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./dist/lib/*.js"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "pnpm build && pnpm start",
		"watch": "tsdown --watch",
		"prisma:generate": "pnpm prisma generate",
		"start": "node --enable-source-maps dist/main.js"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"pg": "^8.21.0"
	},
	"devDependencies": {
		"@prisma/client": "^7.8.0",
		"@rollup/plugin-alias": "6.0.0",
		"prisma": "^7.8.0",
		"tsdown": "0.22.0",
		"typescript": "^6.0.0"
	}
}
