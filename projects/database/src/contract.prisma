// use prisma-next
// Prisma ORM 8 data contract for the WolfStar shared database.
//
// Inferred with `prisma contract infer` from a database carrying the full
// `server/database/migrations` history, then adjusted in three ways: the
// archived `*_v6` tables are dropped; every model is `@@control(external)`
// because the bot owns and migrates these tables; and the empty-array column
// defaults infer writes as `dbgenerated("ARRAY[]::…")` become literal
// `@default([])`, which is the same default and the only one PSL accepts on a
// list. The optional back-reference of each identifying 1:1 is left out too:
// it has no local FK column, so the contract validator rejects it as nullable.
//
// The four `timestamp(3)` columns are authored as `TimestampString(3)` rather
// than the `Timestamp(3)` infer writes. A `Timestamp` column decodes to a
// `Temporal.PlainDateTime`, which needs a global `Temporal` that no Node 22 or
// 24 release provides, so the first read would throw RUNTIME.TEMPORAL_UNAVAILABLE
// on the versions this project targets. The String variants carry PostgreSQL's
// own text, which is what these values are serialized to anyway.
//
// Re-run `pnpm prisma8:infer` against such a database after a migration lands,
// then re-apply that substitution and `pnpm prisma8:emit`.
// The `typed.Json` types come from prisma-orm-extension-typed-json and name the
// `PrismaJson` global namespace declared in `settings/types.ts`; the emitter drops
// `import(...)` expressions, so they cannot point at the module directly.
types {
  PermissionNodeEntries = typed.Json("PrismaJson.PermissionNodeEntries")
  UniqueRoleSetEntries  = typed.Json("PrismaJson.UniqueRoleSetEntries")
  AuditEventChanges     = typed.Json("PrismaJson.AuditEventChanges")
  AutoModerationRuleOptions = typed.Json("PrismaJson.AutoModerationRuleOptions")
  AutoModerationRuleEscalation = typed.Json("PrismaJson.AutoModerationRuleEscalation")
  MessageHistoryMessages = typed.Json("PrismaJson.MessageHistoryMessages")
  AppealFormQuestions = typed.Json("PrismaJson.AppealFormQuestions")
  AppealAnswers = typed.Json("PrismaJson.AppealAnswers")
}

namespace public {
  model AuditChainHead {
    id        String       @id(map: "AuditChainHead_pkey") @default("default")
    hash      String?
    updatedAt TimestampString(3) @map("updated_at")

    @@control(external)
  }

  model AuditEvent {
    id         String       @id(map: "AuditEvent_pkey")
    action     String
    actorType  String       @map("actor_type")
    actorId    BigInt       @map("actor_id")
    actorName  String?      @map("actor_name")
    targetType String?      @map("target_type")
    targetId   BigInt?      @map("target_id")
    outcome    String
    tenantId   BigInt?      @map("tenant_id")
    reason     String?
    timestamp  TimestampString(3)
    changes    AuditEventChanges?
    context    Jsonb?
    prevHash   String?      @map("prev_hash")
    hash       String

    @@index([action, timestamp], map: "AuditEvent_action_timestamp_idx")
    @@index([actorId, timestamp], map: "AuditEvent_actor_id_timestamp_idx")
    @@index([hash], map: "AuditEvent_hash_key", unique: true)
    @@index([tenantId, timestamp], map: "AuditEvent_tenant_id_timestamp_idx")

    @@control(external)
  }

  model CommandLog {
    id          String       @id(map: "CommandLog_pkey")
    guildId     BigInt       @map("guild_id")
    userId      BigInt       @map("user_id")
    commandName String       @map("command_name")
    commandType String       @map("command_type")
    commandId   BigInt?      @map("command_id")
    subcommand  String?
    channelId   BigInt?      @map("channel_id")
    success     Boolean      @default(true)
    errorReason String?      @map("error_reason")
    executedAt  TimestampString(3) @map("executed_at")
    latencyMs   Int?         @map("latency_ms")
    metadata    Jsonb?

    @@index([guildId, commandName, executedAt], map: "CommandLog_guild_id_command_name_executed_at_idx")
    @@index([guildId, executedAt], map: "CommandLog_guild_id_executed_at_idx")
    @@index([guildId, userId, executedAt], map: "CommandLog_guild_id_user_id_executed_at_idx")

    @@control(external)
  }

  model Guild {
    id                BigInt             @id(map: "Guild_pkey")
    language          String             @default("en-US")
    timezone          String             @default("UTC")
    updatesChannelId  BigInt?            @map("updates_channel_id")
    moderationActions ModerationAction[]
    stickyRoles       StickyRole[]

    @@control(external)
  }

  model Modules {
    id         BigInt  @id(map: "Modules_pkey")
    automod    Boolean @default(true)
    moderation Boolean @default(true)
    logs       Boolean @default(true)
    commands   Boolean @default(true)
    roles      Boolean @default(true)
    autodelete  Boolean @default(true)
    autopurge   Boolean @default(true)
    automessage Boolean @default(true)
    reports     Boolean @default(true)
    honeypot    Boolean @default(true)
    guild      Guild   @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Modules_id_fkey")

    @@control(external)
  }

  model GuildAppeals {
    id            BigInt   @id(map: "GuildAppeals_pkey")
    enabled       Boolean  @default(false)
    channelId     BigInt?  @map("channel_id")
    bans          Boolean  @default(true)
    mutes         Boolean  @default(true)
    timeouts      Boolean  @default(true)
    // Not read since the forms: it stays until wolfstar.rocks takes the contract that has them, its reads select it.
    questions     String[] @default([]) @noCheck(elementNotNull)
    managerRoles  BigInt[] @default([]) @noCheck(elementNotNull) @map("manager_roles")
    pingRoles     BigInt[] @default([]) @noCheck(elementNotNull) @map("ping_roles")
    anonymous     Boolean  @default(false)
    thread        String   @default("public")
    cooldownDays  Int      @default(7) @map("cooldown_days")
    maxActive     Int      @default(1) @map("max_active")
    blockOnDenial Boolean  @default(false) @map("block_on_denial")
    modules       Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAppeals_id_fkey")
  }

  // A form of the appeals, built on the dashboard. Its name is unique whatever its case by an index made by hand.
  model AppealForm {
    id              BigInt              @id(map: "AppealForm_pkey") @default(autoincrement())
    guildId         BigInt              @map("guild_id")
    name            String
    description     String?
    icon            String?
    enabled         Boolean             @default(true)
    lockReason      String?             @map("lock_reason")
    types           Int[]               @default([]) @noCheck(elementNotNull)
    requiredRoles   BigInt[]            @default([]) @noCheck(elementNotNull) @map("required_roles")
    restrictedRoles BigInt[]            @default([]) @noCheck(elementNotNull) @map("restricted_roles")
    questions       AppealFormQuestions @default(sql`'[]'::jsonb`)
    position        Int                 @default(0)
    createdAt       TimestampString(3)  @default(now()) @map("created_at")
    updatedAt       TimestampString(3)  @default(now()) @map("updated_at")
    guild           Guild               @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "AppealForm_guild_id_fkey", index: false)

    @@index([guildId, position], map: "AppealForm_guild_id_position_idx")
  }

  // Who a guild keeps from appealing, by hand or by `appeals.block-on-denial`.
  model AppealBlock {
    guildId     BigInt             @map("guild_id")
    userId      BigInt             @map("user_id")
    reason      String?
    moderatorId BigInt?            @map("moderator_id")
    automatic   Boolean            @default(false)
    createdAt   TimestampString(3) @default(now()) @map("created_at")
    guild       Guild              @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "AppealBlock_guild_id_fkey", index: false)

    @@id([guildId, userId], map: "AppealBlock_pkey")
  }

  // What the dashboard asks the bot to do, announced with `NOTIFY appeal_request, '<id>'` in the transaction that inserts
  // it. The ones not done yet are found by a partial index made by hand, as the requests of the join guard.
  model AppealRequest {
    id          BigInt                     @id(map: "AppealRequest_pkey") @default(autoincrement())
    guildId     BigInt                     @map("guild_id")
    kind        pg.enum(AppealRequestKind)
    appealId    BigInt?                    @map("appeal_id")
    userId      BigInt?                    @map("user_id")
    moderatorId BigInt                     @map("moderator_id")
    reason      String?
    createdAt   TimestampString(3)         @default(now()) @map("created_at")
    processedAt TimestampString(3)?        @map("processed_at")
    error       String?
    guild       Guild                      @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "AppealRequest_guild_id_fkey", index: false)

    @@index([guildId, createdAt], map: "AppealRequest_guild_id_created_at_idx")
  }

  model Appeal {
    id         BigInt             @id(map: "Appeal_pkey") @default(autoincrement())
    guildId    BigInt             @map("guild_id")
    caseId     Int                @map("case_id")
    userId     BigInt             @map("user_id")
    formId     BigInt?            @map("form_id")
    answers    AppealAnswers      @default(sql`'[]'::jsonb`)
    status     String             @default("pending")
    reviewerId BigInt?            @map("reviewer_id")
    reason     String?
    channelId  BigInt?            @map("channel_id")
    messageId  BigInt?            @map("message_id")
    threadId   BigInt?            @map("thread_id")
    decidedAt  TimestampString(3)? @map("decided_at")
    createdAt  TimestampString(3) @map("created_at")
    guild      Guild              @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Appeal_guild_id_fkey", index: false)

    @@unique([guildId, caseId], map: "Appeal_guild_id_case_id_key")
  }

  model GuildAutoModeration {
    id          BigInt  @id(map: "GuildAutoModeration_pkey")
    channelId   BigInt? @map("channel_id")
    trackNative Boolean @default(false) @map("track_native")
    modules     Modules @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoModeration_id_fkey")

    @@control(external)
  }

  model GuildAutoDelete {
    id        BigInt   @id(map: "GuildAutoDelete_pkey") @default(autoincrement())
    guildId   BigInt   @map("guild_id")
    channelId BigInt   @unique(map: "GuildAutoDelete_channel_id_key") @map("channel_id")
    delay     Int      @default(0)
    allow     String[] @default([]) @noCheck(elementNotNull)
    bots      Boolean  @default(false)
    guild     Guild    @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoDelete_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildAutoDelete_guild_id_idx")
  }

  model GuildAutoPurge {
    id        BigInt             @id(map: "GuildAutoPurge_pkey") @default(autoincrement())
    guildId   BigInt             @map("guild_id")
    channelId BigInt             @unique(map: "GuildAutoPurge_channel_id_key") @map("channel_id")
    interval  Int
    filter    String             @default("any")
    value     String?
    nextRunAt TimestampString(3) @map("next_run_at")
    guild     Guild              @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoPurge_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildAutoPurge_guild_id_idx")
    @@index([nextRunAt], map: "GuildAutoPurge_next_run_at_idx")
  }

  model GuildAutoMessage {
    id            BigInt             @id(map: "GuildAutoMessage_pkey") @default(autoincrement())
    guildId       BigInt             @map("guild_id")
    channelId     BigInt             @unique(map: "GuildAutoMessage_channel_id_key") @map("channel_id")
    content       String
    interval      Int
    mentions      Boolean            @default(false)
    lastMessageId BigInt?            @map("last_message_id")
    nextRunAt     TimestampString(3) @map("next_run_at")
    guild         Guild              @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoMessage_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildAutoMessage_guild_id_idx")
    @@index([nextRunAt], map: "GuildAutoMessage_next_run_at_idx")
  }

  model GuildAutoModerationRule {
    id                 BigInt                                 @id(map: "GuildAutoModerationRule_pkey") @default(autoincrement())
    guildId            BigInt                                 @map("guild_id")
    name               String
    type               pg.enum(GuildAutoModerationRuleType)
    enabled            Boolean                                @default(true)
    softAction         Int                                    @default(0) @map("soft_action")
    hardAction         pg.enum(GuildAutoModerationHardAction) @map("hard_action")
    hardActionDuration Int?                                   @map("hard_action_duration")
    thresholdMaximum   Int                                    @map("threshold_maximum")
    thresholdDuration  Int                                    @map("threshold_duration")
    ignoredRoles       BigInt[]                               @default([]) @noCheck(elementNotNull) @map("ignored_roles")
    ignoredChannels    BigInt[]                               @default([]) @noCheck(elementNotNull) @map("ignored_channels")
    options            AutoModerationRuleOptions              @default(sql`'{}'::jsonb`)
    escalation         AutoModerationRuleEscalation           @default(sql`'[]'::jsonb`)
    escalationDuration Int                                    @default(86400000) @map("escalation_duration")
    guild              Guild                                  @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoModerationRule_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildAutoModerationRule_guild_id_idx")
  }

  model GuildCommands {
    id                 BigInt   @id(map: "GuildCommands_pkey")
    disabled           String[] @default([]) @noCheck(elementNotNull)
    disabledChannels   BigInt[] @default([]) @noCheck(elementNotNull) @map("disabled_channels")
    disabledInChannels Jsonb    @default(sql`'[]'::jsonb`) @map("disabled_in_channels")
    modules            Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildCommands_id_fkey")

    @@control(external)
  }

  model GuildHoneypot {
    id            BigInt                  @id(map: "GuildHoneypot_pkey")
    channelId     BigInt?                 @map("channel_id")
    logChannelId  BigInt?                 @map("log_channel_id")
    action        pg.enum(HoneypotAction) @default("Softban")
    directMessage Boolean                 @default(true) @map("direct_message")
    warning       Boolean                 @default(true)
    randomName    Boolean                 @default(false) @map("random_name")
    keepActive    Boolean                 @default(false) @map("keep_active")
    modules       Modules                 @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildHoneypot_id_fkey")
  }

  // The settings of the join guard, which stops the members whose account looks like a raid or a spam bot when they
  // join, and of its checkpoint on wolfstar.rocks. The dashboard writes them too, with the same names.
  model GuildJoinGuard {
    id                   BigInt   @id(map: "GuildJoinGuard_pkey")
    enabled              Boolean  @default(false)
    logChannelId         BigInt?  @map("log_channel_id")
    directMessage        Boolean  @default(true) @map("direct_message")
    directMessageContent String?  @map("direct_message_content")
    checkpoint           Boolean  @default(false)
    pendingRoleId        BigInt?  @map("pending_role_id")
    verifiedRoleId       BigInt?  @map("verified_role_id")
    checkpointChannelId  BigInt?  @map("checkpoint_channel_id")
    checkpointMessageId  BigInt?  @map("checkpoint_message_id")
    checkpointTimeout    Int      @default(86400) @map("checkpoint_timeout")
    minimumTrust         Int      @default(1) @map("minimum_trust")
    captcha              Boolean  @default(true)
    connections          Boolean  @default(true)
    sharedBans           Boolean  @default(true) @map("shared_bans")
    allowedUsers         BigInt[] @default([]) @noCheck(elementNotNull) @map("allowed_users")
    allowedRoles         BigInt[] @default([]) @noCheck(elementNotNull) @map("allowed_roles")
    modules              Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildJoinGuard_id_fkey")
  }

  // A rule of the join guard: every condition it sets must match, and then every action it sets is taken. The names
  // are unique per guild whatever their case, by an index made by hand (`20261027T2001_add_join_guard`).
  model GuildJoinGuardRule {
    id               BigInt                        @id(map: "GuildJoinGuardRule_pkey") @default(autoincrement())
    guildId          BigInt                        @map("guild_id")
    name             String
    enabled          Boolean                       @default(true)
    accountAgeMax    Int?                          @map("account_age_max")
    defaultAvatar    Boolean                       @default(false) @map("default_avatar")
    generatedName    Boolean                       @default(false) @map("generated_name")
    nameContains     String?                       @map("name_contains")
    unverifiedBot    Boolean                       @default(false) @map("unverified_bot")
    sendToCheckpoint Boolean                       @default(false) @map("send_to_checkpoint")
    roleId           BigInt?                       @map("role_id")
    directMessage    Boolean                       @default(false) @map("direct_message")
    alertChannelId   BigInt?                       @map("alert_channel_id")
    hardAction       pg.enum(JoinGuardHardAction)? @map("hard_action")
    createdAt        TimestampString(3)            @default(now()) @map("created_at")
    guild            Guild                         @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildJoinGuardRule_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildJoinGuardRule_guild_id_idx")
  }

  // A member the join guard stopped, the queue of the dashboard. A member has one `Waiting` row per guild at most, by a
  // partial unique index made by hand (`20261027T2001_add_join_guard`).
  model JoinGuardCheckpoint {
    id               BigInt                              @id(map: "JoinGuardCheckpoint_pkey") @default(autoincrement())
    guildId          BigInt                              @map("guild_id")
    userId           BigInt                              @map("user_id")
    ruleId           BigInt?                             @map("rule_id")
    ruleName         String                              @map("rule_name")
    status           pg.enum(JoinGuardCheckpointStatus)
    resolution       pg.enum(JoinGuardResolution)?
    moderatorId      BigInt?                             @map("moderator_id")
    caseId           Int?                                @map("case_id")
    accountCreatedAt TimestampString(3)                  @map("account_created_at")
    defaultAvatar    Boolean                             @map("default_avatar")
    generatedName    Boolean                             @map("generated_name")
    trust            Int?
    linkedAccounts   Int                                 @default(0) @map("linked_accounts")
    createdAt        TimestampString(3)                  @default(now()) @map("created_at")
    expiresAt        TimestampString(3)?                 @map("expires_at")
    resolvedAt       TimestampString(3)?                 @map("resolved_at")
    guild            Guild                               @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "JoinGuardCheckpoint_guild_id_fkey", index: false)
    rule             GuildJoinGuardRule?                 @relation(fields:[ruleId], references:[id], onDelete: SetNull, onUpdate: Cascade, map: "JoinGuardCheckpoint_rule_id_fkey", index: false)

    @@index([guildId, status, createdAt], map: "JoinGuardCheckpoint_guild_id_status_created_at_idx")
    @@index([guildId, userId], map: "JoinGuardCheckpoint_guild_id_user_id_idx")
    @@index([ruleId], map: "JoinGuardCheckpoint_rule_id_idx")
  }

  // What the website asks the bot to do, announced with `NOTIFY join_guard_request, '<id>'` in the transaction that
  // inserts it. The ones not done yet are found by a partial index made by hand (`20261027T2001_add_join_guard`).
  model JoinGuardRequest {
    id             BigInt                        @id(map: "JoinGuardRequest_pkey") @default(autoincrement())
    guildId        BigInt                        @map("guild_id")
    kind           pg.enum(JoinGuardRequestKind)
    userId         BigInt?                       @map("user_id")
    checkpointId   BigInt?                       @map("checkpoint_id")
    moderatorId    BigInt?                       @map("moderator_id")
    trust          Int?
    linkedAccounts Int?                          @map("linked_accounts")
    reason         String?
    createdAt      TimestampString(3)            @default(now()) @map("created_at")
    processedAt    TimestampString(3)?           @map("processed_at")
    error          String?
    guild          Guild                         @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "JoinGuardRequest_guild_id_fkey", index: false)

    @@index([guildId, createdAt], map: "JoinGuardRequest_guild_id_created_at_idx")
  }

  // The accounts a guild banned for raiding or scamming, by the join guard or by the honeypot, which the checkpoint of
  // every guild reads. It outlives the guild that banned them, so it has no relation to it.
  model JoinGuardSharedBan {
    userId    BigInt                            @map("user_id")
    guildId   BigInt                            @map("guild_id")
    caseId    Int                               @map("case_id")
    source    pg.enum(JoinGuardSharedBanSource)
    createdAt TimestampString(3)                @default(now()) @map("created_at")

    @@id([guildId, caseId], map: "JoinGuardSharedBan_pkey")
    @@index([userId], map: "JoinGuardSharedBan_user_id_idx")
  }

  model GuildLogs {
    id                     BigInt   @id(map: "GuildLogs_pkey")
    memberAdd              BigInt?  @map("member_add")
    memberRemove           BigInt?  @map("member_remove")
    memberNicknameUpdate   BigInt?  @map("member_nickname_update")
    memberUsernameUpdate   BigInt?  @map("member_username_update")
    messageDelete          BigInt?  @map("message_delete")
    messageDeleteNsfw      BigInt?  @map("message_delete_nsfw")
    messageUpdate          BigInt?  @map("message_update")
    messageUpdateNsfw      BigInt?  @map("message_update_nsfw")
    prune                  BigInt?
    reactionEmojiAdd       BigInt?  @map("reaction_emoji_add")
    reactionEmojiRemove    BigInt?  @map("reaction_emoji_remove")
    reactionEmojiIncludeTwemoji Boolean @default(false) @map("reaction_emoji_include_twemoji")
    image                  BigInt?
    roleCreate             BigInt?  @map("role_create")
    roleUpdate             BigInt?  @map("role_update")
    roleDelete             BigInt?  @map("role_delete")
    channelCreate          BigInt?  @map("channel_create")
    channelUpdate          BigInt?  @map("channel_update")
    channelDelete          BigInt?  @map("channel_delete")
    emojiCreate            BigInt?  @map("emoji_create")
    emojiUpdate            BigInt?  @map("emoji_update")
    emojiDelete            BigInt?  @map("emoji_delete")
    serverUpdate           BigInt?  @map("server_update")
    invites                BigInt?
    threads                BigInt?
    events                 BigInt?
    expressions            BigInt?
    integrations           BigInt?
    boosts                 BigInt?
    command                BigInt?
    settings               BigInt?
    ignoreAll              BigInt[] @default([]) @noCheck(elementNotNull) @map("ignore_all")
    ignoreMessages         BigInt[] @default([]) @noCheck(elementNotNull) @map("ignore_messages")
    ignoreReactions        BigInt[] @default([]) @noCheck(elementNotNull) @map("ignore_reactions")
    modules                Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildLogs_id_fkey")

    @@control(external)
  }

  model GuildModeration {
    id            BigInt  @id(map: "GuildModeration_pkey")
    channelId     BigInt? @map("channel_id")
    trackBans     Boolean @default(false) @map("track_bans")
    trackTimeouts Boolean @default(false) @map("track_timeouts")
    trackRoles    Boolean @default(false) @map("track_roles")
    trackKicks    Boolean @default(false) @map("track_kicks")
    confirmRecentMinutes Int @default(0) @map("confirm_recent_minutes")
    dehoist       Boolean @default(false)
    directMessage Boolean @default(false) @map("direct_message")
    displayReason Boolean @default(true) @map("display_reason")
    displayMessage Boolean @default(true) @map("display_message")
    displayModerator Boolean @default(true) @map("display_moderator")
    modules       Modules @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildModeration_id_fkey")

    @@control(external)
  }

  model GuildModerationReason {
    id      BigInt @id(map: "GuildModerationReason_pkey") @default(autoincrement())
    guildId BigInt @map("guild_id")
    alias   String
    reason  String
    guild   Guild  @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildModerationReason_guild_id_fkey", index: false)

    @@unique([guildId, alias], map: "GuildModerationReason_guild_id_alias_key")
  }

  model GuildWarnThreshold {
    id       BigInt                                 @id(map: "GuildWarnThreshold_pkey") @default(autoincrement())
    guildId  BigInt                                 @map("guild_id")
    count    Int
    period   Int                                    @default(0)
    action   pg.enum(GuildAutoModerationHardAction)
    duration Int?
    guild    Guild                                  @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildWarnThreshold_guild_id_fkey", index: false)

    @@unique([guildId, count], map: "GuildWarnThreshold_guild_id_count_key")
  }

