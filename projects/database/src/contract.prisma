// use prisma-next
// Prisma ORM 8 data contract for the WolfStar shared database.
//
// Inferred with `prisma contract infer` from a database carrying the full
// `server/database/migrations` history, then adjusted in three ways: the
// archived `*_v6` tables are dropped; every model is `@@control(external)`
// because the bot owns and migrates these tables; and the empty-array column
// defaults infer writes as `dbgenerated("ARRAY[]::…")` become literal
// `@default([])`, which is the same default and the only one PSL accepts on a
// list. The optional back-reference of each identifying 1:1 is left out too:
// it has no local FK column, so the contract validator rejects it as nullable.
//
// The four `timestamp(3)` columns are authored as `TimestampString(3)` rather
// than the `Timestamp(3)` infer writes. A `Timestamp` column decodes to a
// `Temporal.PlainDateTime`, which needs a global `Temporal` that no Node 22 or
// 24 release provides, so the first read would throw RUNTIME.TEMPORAL_UNAVAILABLE
// on the versions this project targets. The String variants carry PostgreSQL's
// own text, which is what these values are serialized to anyway.
//
// Re-run `pnpm prisma8:infer` against such a database after a migration lands,
// then re-apply that substitution and `pnpm prisma8:emit`.
// The `typed.Json` types come from prisma-orm-extension-typed-json and name the
// `PrismaJson` global namespace declared in `settings/types.ts`; the emitter drops
// `import(...)` expressions, so they cannot point at the module directly.
types {
  PermissionNodeEntries = typed.Json("PrismaJson.PermissionNodeEntries")
  UniqueRoleSetEntries  = typed.Json("PrismaJson.UniqueRoleSetEntries")
  AuditEventChanges     = typed.Json("PrismaJson.AuditEventChanges")
  AutoModerationRuleOptions = typed.Json("PrismaJson.AutoModerationRuleOptions")
  AutoModerationRuleEscalation = typed.Json("PrismaJson.AutoModerationRuleEscalation")
}

namespace public {
  model AuditChainHead {
    id        String       @id(map: "AuditChainHead_pkey") @default("default")
    hash      String?
    updatedAt TimestampString(3) @map("updated_at")

    @@control(external)
  }

  model AuditEvent {
    id         String       @id(map: "AuditEvent_pkey")
    action     String
    actorType  String       @map("actor_type")
    actorId    BigInt       @map("actor_id")
    actorName  String?      @map("actor_name")
    targetType String?      @map("target_type")
    targetId   BigInt?      @map("target_id")
    outcome    String
    tenantId   BigInt?      @map("tenant_id")
    reason     String?
    timestamp  TimestampString(3)
    changes    AuditEventChanges?
    context    Jsonb?
    prevHash   String?      @map("prev_hash")
    hash       String

    @@index([action, timestamp], map: "AuditEvent_action_timestamp_idx")
    @@index([actorId, timestamp], map: "AuditEvent_actor_id_timestamp_idx")
    @@index([hash], map: "AuditEvent_hash_key", unique: true)
    @@index([tenantId, timestamp], map: "AuditEvent_tenant_id_timestamp_idx")

    @@control(external)
  }

  model CommandLog {
    id          String       @id(map: "CommandLog_pkey")
    guildId     BigInt       @map("guild_id")
    userId      BigInt       @map("user_id")
    commandName String       @map("command_name")
    commandType String       @map("command_type")
    commandId   BigInt?      @map("command_id")
    subcommand  String?
    channelId   BigInt?      @map("channel_id")
    success     Boolean      @default(true)
    errorReason String?      @map("error_reason")
    executedAt  TimestampString(3) @map("executed_at")
    latencyMs   Int?         @map("latency_ms")
    metadata    Jsonb?

    @@index([guildId, commandName, executedAt], map: "CommandLog_guild_id_command_name_executed_at_idx")
    @@index([guildId, executedAt], map: "CommandLog_guild_id_executed_at_idx")
    @@index([guildId, userId, executedAt], map: "CommandLog_guild_id_user_id_executed_at_idx")

    @@control(external)
  }

  model Guild {
    id                BigInt             @id(map: "Guild_pkey")
    language          String             @default("en-US")
    moderationActions ModerationAction[]
    stickyRoles       StickyRole[]

    @@control(external)
  }

  model Modules {
    id         BigInt  @id(map: "Modules_pkey")
    automod    Boolean @default(true)
    moderation Boolean @default(true)
    logs       Boolean @default(true)
    commands   Boolean @default(true)
    roles      Boolean @default(true)
    guild      Guild   @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Modules_id_fkey")

    @@control(external)
  }

  model GuildAutoModeration {
    id          BigInt  @id(map: "GuildAutoModeration_pkey")
    channelId   BigInt? @map("channel_id")
    trackNative Boolean @default(false) @map("track_native")
    modules     Modules @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoModeration_id_fkey")

    @@control(external)
  }

  model GuildAutoDelete {
    id        BigInt   @id(map: "GuildAutoDelete_pkey") @default(autoincrement())
    guildId   BigInt   @map("guild_id")
    channelId BigInt   @unique(map: "GuildAutoDelete_channel_id_key") @map("channel_id")
    delay     Int      @default(0)
    allow     String[] @default([]) @noCheck(elementNotNull)
    bots      Boolean  @default(false)
    guild     Guild    @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoDelete_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildAutoDelete_guild_id_idx")
  }

  model GuildAutoPurge {
    id        BigInt             @id(map: "GuildAutoPurge_pkey") @default(autoincrement())
    guildId   BigInt             @map("guild_id")
    channelId BigInt             @unique(map: "GuildAutoPurge_channel_id_key") @map("channel_id")
    interval  Int
    filter    String             @default("any")
    value     String?
    nextRunAt TimestampString(3) @map("next_run_at")
    guild     Guild              @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoPurge_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildAutoPurge_guild_id_idx")
    @@index([nextRunAt], map: "GuildAutoPurge_next_run_at_idx")
  }

  model GuildAutoModerationRule {
    id                 BigInt                                 @id(map: "GuildAutoModerationRule_pkey") @default(autoincrement())
    guildId            BigInt                                 @map("guild_id")
    name               String
    type               pg.enum(GuildAutoModerationRuleType)
    enabled            Boolean                                @default(true)
    softAction         Int                                    @default(0) @map("soft_action")
    hardAction         pg.enum(GuildAutoModerationHardAction) @map("hard_action")
    hardActionDuration Int?                                   @map("hard_action_duration")
    thresholdMaximum   Int                                    @map("threshold_maximum")
    thresholdDuration  Int                                    @map("threshold_duration")
    ignoredRoles       BigInt[]                               @default([]) @noCheck(elementNotNull) @map("ignored_roles")
    ignoredChannels    BigInt[]                               @default([]) @noCheck(elementNotNull) @map("ignored_channels")
    options            AutoModerationRuleOptions              @default(sql`'{}'::jsonb`)
    escalation         AutoModerationRuleEscalation           @default(sql`'[]'::jsonb`)
    escalationDuration Int                                    @default(86400000) @map("escalation_duration")
    guild              Guild                                  @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildAutoModerationRule_guild_id_fkey", index: false)

    @@index([guildId], map: "GuildAutoModerationRule_guild_id_idx")
  }

  model GuildCommands {
    id                 BigInt   @id(map: "GuildCommands_pkey")
    disabled           String[] @default([]) @noCheck(elementNotNull)
    disabledChannels   BigInt[] @default([]) @noCheck(elementNotNull) @map("disabled_channels")
    disabledInChannels Jsonb    @default(sql`'[]'::jsonb`) @map("disabled_in_channels")
    modules            Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildCommands_id_fkey")

    @@control(external)
  }

  model GuildLogs {
    id                     BigInt   @id(map: "GuildLogs_pkey")
    memberAdd              BigInt?  @map("member_add")
    memberRemove           BigInt?  @map("member_remove")
    memberNicknameUpdate   BigInt?  @map("member_nickname_update")
    memberUsernameUpdate   BigInt?  @map("member_username_update")
    messageDelete          BigInt?  @map("message_delete")
    messageDeleteNsfw      BigInt?  @map("message_delete_nsfw")
    messageUpdate          BigInt?  @map("message_update")
    messageUpdateNsfw      BigInt?  @map("message_update_nsfw")
    prune                  BigInt?
    reactionEmojiAdd       BigInt?  @map("reaction_emoji_add")
    reactionEmojiRemove    BigInt?  @map("reaction_emoji_remove")
    reactionEmojiIncludeTwemoji Boolean @default(false) @map("reaction_emoji_include_twemoji")
    image                  BigInt?
    roleCreate             BigInt?  @map("role_create")
    roleUpdate             BigInt?  @map("role_update")
    roleDelete             BigInt?  @map("role_delete")
    channelCreate          BigInt?  @map("channel_create")
    channelUpdate          BigInt?  @map("channel_update")
    channelDelete          BigInt?  @map("channel_delete")
    emojiCreate            BigInt?  @map("emoji_create")
    emojiUpdate            BigInt?  @map("emoji_update")
    emojiDelete            BigInt?  @map("emoji_delete")
    serverUpdate           BigInt?  @map("server_update")
    command                BigInt?
    settings               BigInt?
    ignoreAll              BigInt[] @default([]) @noCheck(elementNotNull) @map("ignore_all")
    ignoreMessages         BigInt[] @default([]) @noCheck(elementNotNull) @map("ignore_messages")
    ignoreReactions        BigInt[] @default([]) @noCheck(elementNotNull) @map("ignore_reactions")
    modules                Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildLogs_id_fkey")

    @@control(external)
  }

  model GuildModeration {
    id            BigInt  @id(map: "GuildModeration_pkey")
    channelId     BigInt? @map("channel_id")
    trackBans     Boolean @default(false) @map("track_bans")
    trackTimeouts Boolean @default(false) @map("track_timeouts")
    modules       Modules @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildModeration_id_fkey")

    @@control(external)
  }

  model GuildPermissions {
    id      BigInt  @id(map: "GuildPermissions_pkey")
    users   PermissionNodeEntries @default(sql`'[]'::jsonb`)
    roles   PermissionNodeEntries @default(sql`'[]'::jsonb`)
    modules Modules @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildPermissions_id_fkey")

    @@control(external)
  }

  model GuildReports {
    id        BigInt  @id(map: "GuildReports_pkey")
    channelId BigInt? @map("channel_id")
    roleId       BigInt?  @map("role_id")
    anonymous    Boolean  @default(false)
    notify       Boolean  @default(true)
    blockedUsers BigInt[] @default([]) @noCheck(elementNotNull) @map("blocked_users")
    modules      Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildReports_id_fkey")
  }

  model Report {
    id          BigInt                @id(map: "Report_pkey") @default(autoincrement())
    guildId     BigInt                @map("guild_id")
    reporterId  BigInt                @map("reporter_id")
    targetId    BigInt                @map("target_id")
    targetTag   String                @map("target_tag")
    channelId   BigInt?               @map("channel_id")
    messageId   BigInt?               @map("message_id")
    reason      String
    content     String?
    attachments String[]              @default([]) @noCheck(elementNotNull)
    anonymous   Boolean               @default(false)
    status      pg.enum(ReportStatus)
    action      String?
    caseId      Int?                  @map("case_id")
    moderatorId BigInt?               @map("moderator_id")
    createdAt   TimestampString(3)    @default(now()) @map("created_at")
    closedAt    TimestampString(3)?   @map("closed_at")
    guild       Guild                 @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "Report_guild_id_fkey", index: false)

    @@index([guildId, id], map: "Report_guild_id_id_idx")
    @@index([guildId, targetId], map: "Report_guild_id_target_id_idx")
  }

  model GuildRoles {
    id                   BigInt   @id(map: "GuildRoles_pkey")
    initial              BigInt[] @default([]) @noCheck(elementNotNull)
    initialHumans        BigInt[] @default([]) @noCheck(elementNotNull) @map("initial_humans")
    initialRobots        BigInt[] @default([]) @noCheck(elementNotNull) @map("initial_robots")
    admin                BigInt[] @default([]) @noCheck(elementNotNull)
    moderator            BigInt[] @default([]) @noCheck(elementNotNull)
    muted                BigInt?
    public               BigInt[] @default([]) @noCheck(elementNotNull)
    removeInitial        Boolean  @default(false) @map("remove_initial")
    uniqueRoleSets       UniqueRoleSetEntries @default(sql`'[]'::jsonb`) @map("unique_role_sets")
    restrictedReaction   BigInt?  @map("restricted_reaction")
    restrictedEmbed      BigInt?  @map("restricted_embed")
    restrictedEmoji      BigInt?  @map("restricted_emoji")
    restrictedAttachment BigInt?  @map("restricted_attachment")
    restrictedVoice      BigInt?  @map("restricted_voice")
    modules              Modules  @relation(fields:[id], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "GuildRoles_id_fkey")

    @@control(external)
  }

  model ModerationAction {
    id          Int
    guildId     BigInt                        @map("guild_id")
    action      pg.enum(ModerationActionType)
    metadata    Int
    createdAt   TimestampString(3)                  @default(now()) @map("created_at")
    duration    Int
    targetId    BigInt                        @map("target_id")
    moderatorId BigInt                        @map("moderator_id")
    reason      String?
    referenceId Int?                          @map("reference_id")
    guild       Guild                         @relation(fields:[guildId], references:[id], onDelete: Restrict, onUpdate: Cascade, map: "ModerationAction_guild_id_fkey", index: false)

    @@id([id, guildId], map: "ModerationAction_pkey")

    @@control(external)
  }

  model StickyRole {
    userId  BigInt   @map("user_id")
    guildId BigInt   @map("guild_id")
    roleIds BigInt[] @noCheck(elementNotNull) @map("role_ids")
    guild   Guild    @relation(fields:[guildId], references:[id], onDelete: Restrict, onUpdate: Cascade, map: "StickyRole_guild_id_fkey", index: false)

    @@id([userId, guildId], map: "StickyRole_pkey")

    @@control(external)
  }

  model User {
    id     BigInt  @id(map: "User_pkey")
    report Boolean @default(true)

    @@control(external)
  }

  native_enum GuildAutoModerationRuleType {
    Attachments = "Attachments"
    Capitals = "Capitals"
    Invites = "Invites"
    Links = "Links"
    Newlines = "Newlines"
    NoMentionSpam = "NoMentionSpam"
    Words = "Words"
    Zalgo = "Zalgo"
    // A native enum only takes new values at its end:
    Phishing = "Phishing"
    Stickers = "Stickers"
    Duplicates = "Duplicates"
    Characters = "Characters"
    Emojis = "Emojis"
    MessageSpam = "MessageSpam"
    ImageSpam = "ImageSpam"
    LinksCooldown = "LinksCooldown"
    MassMentions = "MassMentions"
    MentionsCooldown = "MentionsCooldown"
    Spoilers = "Spoilers"
    MaskedLinks = "MaskedLinks"
    StickersCooldown = "StickersCooldown"
  }

  native_enum ReportStatus {
    Open = "Open"
    Actioned = "Actioned"
    Dismissed = "Dismissed"
  }

  native_enum GuildAutoModerationHardAction {
    VoiceKick = "VoiceKick"
    Warning = "Warning"
    Timeout = "Timeout"
    Mute = "Mute"
    Kick = "Kick"
    Softban = "Softban"
    Ban = "Ban"
  }

  native_enum ModerationActionType {
    AddRole = "AddRole"
    RemoveRole = "RemoveRole"
    Nickname = "Nickname"
    AddWarning = "AddWarning"
    RemoveWarning = "RemoveWarning"
    Timeout = "Timeout"
    TimeoutEnd = "TimeoutEnd"
    Kick = "Kick"
    Softban = "Softban"
    Ban = "Ban"
    Unban = "Unban"
  }
}
