    guild     Guild   @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "ModerationCaseData_guild_id_fkey", index: false)

    @@id([caseId, guildId], map: "ModerationCaseData_pkey")
