  model ModerationAction {
    id          Int
    guildId     BigInt                        @map("guild_id")
    action      pg.enum(ModerationActionType)
    metadata    Int
    createdAt   TimestampString(3)                  @default(now()) @map("created_at")
    duration    Int
    targetId    BigInt                        @map("target_id")
    moderatorId BigInt                        @map("moderator_id")
    reason      String?
    referenceId Int?                          @map("reference_id")
    guild       Guild                         @relation(fields:[guildId], references:[id], onDelete: Restrict, onUpdate: Cascade, map: "ModerationAction_guild_id_fkey", index: false)

    @@id([id, guildId], map: "ModerationAction_pkey")
    // The table is owned outside this repository, so the indexes are created by hand (`20261018T1353_add_moderation_action_indexes`).
    @@index([guildId, createdAt, id], map: "ModerationAction_guild_id_created_at_id_idx")
    @@index([guildId, targetId, createdAt], map: "ModerationAction_guild_id_target_id_created_at_idx")

    @@control(external)
  }

  // What a case holds that the externally owned `ModerationAction` has no column for.
  // The guilds the conversion of the legacy tables is done with, read at the start so a backup only adds the ones it did
  // not have. `followedUpAt` is set once what needs Discord was done too: the permission nodes, the jobs of the cases.
  model LegacyMigratedGuild {
    guildId      BigInt              @id(map: "LegacyMigratedGuild_pkey") @map("guild_id")
    migratedAt   TimestampString(3)  @default(now()) @map("migrated_at")
    followedUpAt TimestampString(3)? @map("followed_up_at")
  }

