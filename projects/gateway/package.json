{
	"name": "wolfstar-gateway",
	"version": "7.0.0",
	"description": "Gateway for Wolfstar's projects",
	"author": "WolfStar Project",
	"license": "Apache-2.0",
	"private": true,
	"main": "dist/main.js",
	"type": "module",
	"imports": {
		"#lib/*": "./dist/lib/*.js"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "pnpm build && pnpm start",
		"watch": "tsdown --watch",
		"clean": "node scripts/clean.mjs",
		"start": "node --enable-source-maps dist/main.js"
	},
	"dependencies": {
		"@discordjs/rest": "^2.6.3",
		"@discordjs/ws": "^2.0.4",
		"@sapphire/utilities": "^3.18.2",
		"@wolfstar/env-utilities": "^2.0.8",
		"@wolfstar/start-banner": "^2.1.0",
		"discord-api-types": "^0.38.55",
		"gradient-string": "^3.0.0",
		"wolfstar-shared": "workspace:^"
	},
	"devDependencies": {
		"@rollup/plugin-alias": "6.0.0",
		"tsdown": "0.23.0",
		"typescript": "^7.0.2"
	}
}
